    def __init__(self):\
        super().__init__()\
        self.input = QLineEdit()\
        self.result = QLabel()\
        btn = QPushButton('\uc0\u1056 \u1072 \u1089 \u1089 \u1095 \u1080 \u1090 \u1072 \u1090 \u1100 ')\
        btn.clicked.connect(self.on_click)\
        layout = QVBoxLayout(self)\
        for w in (self.input, btn, self.result):\
            layout.addWidget(w)\
\
    def on_click(self):\
        base = float(self.input.text())\
        tax = base * 0.1\
        pension = base * 0.1\
        net = base - tax - pension\
        self.result.setText(f'\uc0\u1053 \u1072  \u1088 \u1091 \u1082 \u1080 : \{net\}')\
        with open('salary.csv', 'a', encoding='utf-8') as f:\
            f.write(f'\{base\},\{tax\},\{pension\},\{net\}\\n')\
