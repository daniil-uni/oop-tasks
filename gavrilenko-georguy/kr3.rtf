class Truck:\
    speed = 80\
    def deliver(self, cargo: str) -> str:\
        return f'\uc0\u1043 \u1088 \u1091 \u1079 \u1086 \u1074 \u1080 \u1082  \u1074 \u1077 \u1079 \u1105 \u1090  \{cargo\} \u1087 \u1086  \u1076 \u1086 \u1088 \u1086 \u1075 \u1077 '\
\
class Ship:\
    speed = 30\
    def deliver(self, cargo: str) -> str:\
        return f'\uc0\u1050 \u1086 \u1088 \u1072 \u1073 \u1083 \u1100  \u1074 \u1077 \u1079 \u1105 \u1090  \{cargo\} \u1087 \u1086  \u1084 \u1086 \u1088 \u1102 '\
\
class Plane:\
    speed = 800\
    def deliver(self, cargo: str) -> str:\
        return f'\uc0\u1057 \u1072 \u1084 \u1086 \u1083 \u1105 \u1090  \u1074 \u1077 \u1079 \u1105 \u1090  \{cargo\} \u1087 \u1086  \u1074 \u1086 \u1079 \u1076 \u1091 \u1093 \u1091 '\
\
class Logistics:\
    def create_transport(self):\
        raise NotImplementedError\
\
    def plan_delivery(self, cargo: str, distance_km: int) -> str:\
        transport = self.create_transport()\
        hours = distance_km / transport.speed\
        return f'\{transport.deliver(cargo)\}, \uc0\u1074  \u1087 \u1091 \u1090 \u1080 : \{hours:.1f\} \u1095 '\
\
\
class RoadLogistics(Logistics):\
    def create_transport(self):\
        return Truck()\
\
class SeaLogistics(Logistics):\
    def create_transport(self):\
        return Ship()\
\
class AirLogistics(Logistics):\
    def create_transport(self):\
        return Plane()\
\
def get_logistics(kind: str):\
    if kind == 'road':\
        return RoadLogistics()\
    elif kind == 'sea':\
        return SeaLogistics()\
    elif kind == 'air':\
        return AirLogistics()\
    else:\
        raise ValueError(f'\uc0\u1053 \u1077 \u1080 \u1079 \u1074 \u1077 \u1089 \u1090 \u1085 \u1099 \u1081  \u1090 \u1080 \u1087  \u1090 \u1088 \u1072 \u1085 \u1089 \u1087 \u1086 \u1088 \u1090 \u1072 : \{kind\}')\
\
\
if __name__ == '__main__':\
    for kind in ('road', 'sea', 'air'):\
        print(get_logistics(kind).plan_delivery('\uc0\u1052 \u1077 \u1073 \u1077 \u1083 \u1100 ', 2400))\
